{
	"name": "@wordpress/wp-feature-notifications-stories",
	"version": "1.0.0",
	"private": true,
	"description": "Storybook documentation for the WordPress Feature Notifications plugin.",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"WordPress",
		"notifications",
		"storybook"
	],
	"homepage": "https://github.com/WordPress/wp-feature-notifications#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/WordPress/wp-feature-notifications.git",
		"directory": "storybook"
	},
	"bugs": {
		"url": "https://github.com/WordPress/wp-feature-notifications/issues"
	},
	"main": "stories/Introduction.stories.mdx",
	"devDependencies": {
		"@storybook/addon-a11y": "^7.6.1",
		"@storybook/addon-docs": "^7.6.1",
		"@storybook/addon-essentials": "^7.6.1",
		"@storybook/addon-interactions": "^7.6.1",
		"@storybook/addon-links": "^7.6.1",
		"@storybook/addon-mdx-gfm": "^7.6.1",
		"@storybook/addons": "^7.6.1",
		"@storybook/blocks": "^7.6.1",
		"@storybook/react": "^7.6.1",
		"@storybook/react-webpack5": "^7.6.1",
		"@storybook/source-loader": "^7.6.1",
		"@storybook/theming": "^7.6.1",
		"@wordpress/wp-feature-notifications": "../",
		"storybook": "^7.6.1"
	},
	"peerDependencies": {
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	},
	"scripts": {
		"start": "storybook dev -p 6006",
		"build": "storybook build --output-dir ../docs/"
	},
	"eslintConfig": {
		"extends": [
			"plugin:@wordpress/eslint-plugin/recommended"
		],
		"overrides": [
			{
				"files": [
					"**/*.stories.*"
				],
				"rules": {
					"import/no-anonymous-default-export": "off"
				}
			}
		]
	}
}
